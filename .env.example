# Server
HOST=127.0.0.1
PORT=8001

# Model / filesystem
MODEL_PATH=./models/image-safety-classifier-l.onnx
LOG_DIR=./logs
ALLOWED_DIRS=./files

# Optional: leave blank to use ffmpeg/ffprobe from PATH.
# Windows examples:
# FFMPEG_BINARY=C:\\ffmpeg\\bin\\ffmpeg.exe
# FFPROBE_BINARY=C:\\ffmpeg\\bin\\ffprobe.exe
FFMPEG_BINARY=
FFPROBE_BINARY=

# Decision thresholds
NSFW_THRESHOLD=0.85
MIN_SUSPICIOUS_RATIO=0.15
MIN_CONSECUTIVE_FRAMES=3
MIN_SUSPICIOUS_ABSOLUTE_COUNT=3
SINGLE_FRAME_OVERRIDE=0.98

# Sampling: long videos are never fully decoded by the API.
# About one sample every 10 seconds, with 8 minimum and 24 maximum.
MIN_MEDIA_FRAMES=8
MAX_MEDIA_FRAMES=24
SAMPLE_INTERVAL_SECONDS=10

# Limits / timeouts
MAX_FILE_SIZE_MB=4096
MAX_VIDEO_SIZE_MB=4096
MAX_IMAGE_SIZE_MB=50
MAX_CONCURRENT_INFERENCE=1
INFERENCE_BATCH_SIZE=4
DETECTION_TIMEOUT=120
FFPROBE_TIMEOUT=20
FFMPEG_FRAME_TIMEOUT=12

# Logging
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Model source
MODEL_REPO=OwenElliott/image-safety-classifier-l
MODEL_FILE=onnx/image-safety-classifier-l.onnx
MODEL_INPUT_SIZE=224
